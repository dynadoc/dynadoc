# Dynadoc environment variables
# Copy this file to .env.local and adjust as needed:
#   cp .env.example .env.local

# Base URL of the Dynadoc API this client talks to.
#
# The default is the local stub, not production, and that is deliberate. An
# unset or production VITE_API_URL does not mean "no backend": it means every
# login, every document and every share you create while developing lands in
# the live service, with nothing on screen to tell you. Start the stub with
# `npm run stub-bridge` and it answers here.
#
#   Local stub (npm run stub-bridge): http://localhost:7070
#   A local bridge of your own:       http://localhost:7070
#   Production:                       https://api.dynadoc.dashmake.com
#
# See tools/stub-bridge/README.md for what the stub does and does not answer.
VITE_API_URL=http://localhost:7070

# IPC WebSocket URL override — leave empty to use the default
VITE_IPC_WS_URL=

# Speech-to-text WebSocket endpoint used by the meeting transcription worker.
# Leave empty to disable transcription; set it at build time to enable it.
VITE_TRANSCRIBE_WS_URL=
